# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{html,css,scss,json{5,},y{a,}ml}]
indent_style = space
indent_size = 2

[*.md]
# Markdown inserts newlines when there are two spaces at the end of a line
# trim_trailing_whitespace = false
indent_style = space
indent_size = 4
