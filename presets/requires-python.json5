// Ensure to get dependency updates for pinned Python version in pyproject.toml like .python-version.
// See: https://github.com/renovatebot/renovate/discussions/34793
{
    "customManagers": [
        {
            "description": "Manage required Python version",
            "customType": "regex",
            // https://docs.renovatebot.com/modules/manager/pep621/#default-config
            "fileMatch": [
                "(^|/)pyproject\\.toml$",
                "(^|/)uv\\.lock$",
            ],
            "matchStrings": [
                "requires-python\\s=\\s\"==(?<currentValue>.+)\""
            ],
            // support ==major.minor.patch and ==major.minor.*
            "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>(?:\\d+|\\*)))?$",
            "depNameTemplate": "python",
            "datasourceTemplate": "docker",
        },
    ],
}
