{
  // Group updates for Docker actions
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
      ],
      "matchPackageNames": [
        "/^docker\\//",
      ],
      "groupName": "docker actions",
    },
  ],
}
